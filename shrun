/* ══════════════ Apple Reference Design System 준수 (기본 규칙 위에 덮어쓴다)
   · 인터랙티브 색은 Action Blue 하나  · UI 그림자 금지
   · 라디우스 0/5/8/11/18/pill        · weight 500 금지
   · 본문 17px / 1.47 / -0.374px      · 장식 그라디언트 금지            */
#mcv-root{
  --blue:#0071e3; --link:#0066cc; --link-dark:#2997ff;
  --dark:#1d1d1f; --bg:#f5f5f7; --card:#ffffff; --pearl:#fafafc;
  --line:rgba(0,0,0,.08); --line2:#e0e0e0; --divider:#f0f0f0;
  --muted:#6e6e73; --sub:#515154; --dim:#7a7a7a;
  --r:18px; --r-md:11px; --r-sm:8px; --r-xs:5px; --pill:9999px;
  --ease:cubic-bezier(.28,.11,.32,1);
  font-family:'SF Pro Text',-apple-system,BlinkMacSystemFont,system-ui,
    'Apple SD Gothic Neo',Pretendard,'Malgun Gothic','Noto Sans KR',sans-serif;
  -webkit-font-smoothing:antialiased;
  font-size:17px; line-height:1.47; letter-spacing:-.374px;
}
/* 발행 코스도는 보는 사람의 다크모드를 따라가지 않는다 — 언제나 밝은 면.
   참가자·스탭이 제각각인 기기로 열고, 인쇄·캡처해서 돌려 보는 문서이기 때문이다.
   (다크모드를 따라가던 때 실측: 제한시간 제목 1.06:1 · 표 내용 1.60:1 — 사실상 안 보였다) */
#mcv-root{ color-scheme:light; }
#mcv-root .mcv-wrap{max-width:1120px;padding:24px 20px 48px;}
/* 헤더 — 색 띠·그라디언트 없이 타이포로만 */
#mcv-root header,#mcv-root header.admin{
  background:var(--card);color:var(--dark);border:1px solid var(--line2);
  border-radius:var(--r);padding:32px;margin-bottom:24px;box-shadow:none;}
#mcv-root header h1{font-size:40px;font-weight:600;line-height:1.1;letter-spacing:0;margin-bottom:10px;}
#mcv-root header p{opacity:1;color:var(--muted);font-size:17px;line-height:1.47;letter-spacing:-.374px;}
#mcv-root header .mcv-tag{background:var(--divider);color:var(--sub);font-weight:600;
  font-size:14px;letter-spacing:-.224px;padding:4px 12px;border-radius:var(--pill);}
#mcv-root header.admin .mcv-tag{background:var(--dark);color:var(--card);}
#mcv-root .mcv-stats{gap:8px;margin-top:24px;}
#mcv-root .mcv-stat{background:var(--bg);border-radius:var(--r-md);padding:10px 16px;
  font-size:12px;color:var(--muted);letter-spacing:0;}
#mcv-root .mcv-stat b{font-size:21px;font-weight:600;line-height:1.19;letter-spacing:-.231px;
  color:var(--dark);margin-top:3px;}
#mcv-root .mcv-kakao-open{border-radius:var(--pill);padding:11px 22px;font-weight:400;
  font-size:17px;letter-spacing:-.374px;}
/* 카드 — 흰 면 · 1px 헤어라인 · 18px · 그림자 없음 */
#mcv-root .mcv-card{border-radius:var(--r);border:1px solid var(--line2);box-shadow:none;margin-bottom:24px;}
#mcv-root .mcv-card h2{font-size:17px;font-weight:600;line-height:1.24;letter-spacing:-.374px;padding:17px 24px;}
/* 세그먼트 — configurator chip (알약 · 선택 시 2px Action Blue) */
#mcv-root .mcv-seg{border:none;background:transparent;border-radius:0;overflow:visible;
  display:inline-flex;gap:6px;flex-wrap:wrap;}
#mcv-root .mcv-seg button{background:var(--card);border:1px solid var(--line2);border-radius:var(--pill);
  padding:7px 15px;color:var(--dark);font-size:14px;font-weight:400;letter-spacing:-.224px;
  transition:border-color .18s var(--ease), background .18s var(--ease), transform .12s var(--ease);}
#mcv-root .mcv-seg button:not(:last-child){border-right:1px solid var(--line2);}
#mcv-root .mcv-seg button:hover{background:var(--bg);}
#mcv-root .mcv-seg button:active{transform:scale(.95);}
#mcv-root .mcv-seg button.mcv-on,
#mcv-root .mcv-seg.mcv-course button.mcv-on,
#mcv-root .mcv-seg.mcv-kk button.mcv-on{background:var(--card);color:var(--dark);
  border:2px solid var(--blue);padding:6px 14px;font-weight:600;box-shadow:none;}
/* 지도 */
#mcv-root #mcv-map{height:600px;background:var(--bg);}
#mcv-root #mcv-mapErr{background:color-mix(in srgb, var(--card) 90%, transparent);
  backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);}
#mcv-root #mcv-mapErr .mcv-in{color:var(--muted);font-size:17px;line-height:1.47;}
#mcv-root #mcv-mapErr code{background:var(--divider);border-radius:var(--r-xs);}
/* 칩 · 범례 */
#mcv-root .mcv-chip{background:var(--card);border:1px solid var(--line2);border-radius:var(--pill);
  padding:6px 14px;color:var(--dark);cursor:pointer;font-size:14px;letter-spacing:-.224px;
  transition:border-color .18s var(--ease), background .18s var(--ease);}
#mcv-root .mcv-chip:hover{background:var(--bg);}
#mcv-root .mcv-chip-off{opacity:.4;border-style:dashed;}
#mcv-root .mcv-sumchip{background:var(--bg);border-radius:var(--r-md);border:none;}
/* 표 */
#mcv-root table{font-size:14px;letter-spacing:-.224px;}
#mcv-root th{background:var(--bg);color:var(--muted);font-weight:600;font-size:12px;letter-spacing:0;
  border-bottom:1px solid var(--line);padding:11px 14px;}
#mcv-root td{border-bottom:1px solid var(--line);padding:10px 14px;color:var(--dark);}
#mcv-root tbody tr:hover td{background:var(--bg);}
#mcv-root tfoot td{background:var(--bg);font-weight:600;}
#mcv-root .mcv-titleicon{border-radius:var(--r-sm);}
/* 항목 카드 (참가자용) */
#mcv-root .mcv-item{border-radius:var(--r-md);border:1px solid var(--line2);box-shadow:none;
  transition:border-color .18s var(--ease), background .18s var(--ease);}
#mcv-root .mcv-item:hover{background:var(--bg);}
#mcv-root .mcv-nm{font-size:17px;font-weight:600;letter-spacing:-.374px;}
#mcv-root .mcv-c{border-radius:var(--pill);font-weight:600;font-size:14px;letter-spacing:-.224px;}
#mcv-root .mcv-memo,#mcv-root .mcv-note,#mcv-root .mcv-ops{color:var(--muted);font-size:14px;letter-spacing:-.224px;}
/* 지도 마커 — 지도 위 요소는 translucent chip 문법 */
#mcv-root .mcv-kstart{border-radius:var(--pill);padding:4px 12px;font-weight:600;
  background:#1d6f42;box-shadow:none;letter-spacing:0;}
#mcv-root .mcv-kturn{border-radius:var(--pill);padding:4px 12px;font-weight:600;
  background:#c2600a;box-shadow:none;letter-spacing:0;}
#mcv-root .mcv-kpoi{border:2px solid #fff;box-shadow:none;}
/* ── 시설 정보 카드 — 지도 가운데, 카드 한 장, 불투명 ──
   앞서 세 군데에서 .mcv-kinfo 와 .mcv-pop 에 각각 배경을 칠해 카드가 두 겹으로 보였고,
   rgba(255,255,255,.75) + blur 라 뒤 지도가 비쳐 글자가 읽히지 않았다. 여기서 정리한다. */
#mcv-root .mcv-infoLayer{position:absolute;inset:0;z-index:950;
  display:flex;align-items:center;justify-content:center;padding:16px;}
#mcv-root .mcv-infoScrim{position:absolute;inset:0;background:rgba(0,0,0,.32);
  animation:mcvFade .18s ease both;}
#mcv-root .mcv-kinfo,
#mcv-root #mcv-map .mcv-kinfo{
  position:relative;white-space:normal;
  background:var(--card) !important;                 /* 불투명 — 뒤 지도가 비치지 않는다 */
  border:1px solid var(--line2) !important;
  border-radius:var(--r) !important;
  box-shadow:rgba(0,0,0,.22) 0 8px 40px 0 !important;
  backdrop-filter:none !important;-webkit-backdrop-filter:none !important;
  padding:20px 20px 18px !important;
  width:min(340px, 100%);max-width:min(340px, 100%);
  max-height:100%;overflow-y:auto;overscroll-behavior:contain;
  color:var(--dark);font-size:14px;line-height:1.5;letter-spacing:-.224px;
  animation:mcvPop .22s cubic-bezier(.34,1.32,.48,1) both;}
/* 안쪽 덩어리는 배경을 갖지 않는다 — 카드는 한 장뿐 */
#mcv-root .mcv-pop,#mcv-root #mcv-map .mcv-pop{background:none !important;border:none !important;
  box-shadow:none !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;
  padding:0 !important;min-width:0 !important;}
/* 말풍선 꼬리 제거 — 이제 마커에 매달리지 않는다 */
#mcv-root .mcv-kinfo:after,#mcv-root #mcv-map .mcv-kinfo:after{display:none !important;content:none !important;}
#mcv-root .mcv-kinfo .mcv-x,#mcv-root #mcv-map .mcv-kinfo .mcv-x{
  position:absolute;top:10px;right:10px;width:30px;height:30px;
  display:flex;align-items:center;justify-content:center;
  border:none;background:var(--pearl);color:var(--sub);
