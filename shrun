<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>시흥마라톤</title>

</head>
<body style="margin:0;background:#f5f5f7">
<!--MCV_FRAGMENT_START-->
<style>#mcv-root{--blue:#1976d2;--dark:#263238;--bg:#f4f6f8;--card:#fff;--line:#e0e4e8;}
#mcv-root, #mcv-root *{margin:0;padding:0;box-sizing:border-box;}
#mcv-root{font-family:'Apple SD Gothic Neo','Malgun Gothic','Noto Sans KR',sans-serif;background:var(--bg);color:var(--dark);}
#mcv-root .mcv-wrap{max-width:1100px;margin:0 auto;padding:16px;}
#mcv-root header{background:linear-gradient(135deg,#0d47a1,#1976d2);color:#fff;border-radius:14px;padding:22px 24px;margin-bottom:16px;}
#mcv-root header.admin{background:linear-gradient(135deg,#263238,#455a64);}
#mcv-root header h1{font-size:1.5rem;margin-bottom:6px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
#mcv-root header .mcv-tag{font-size:.7rem;background:rgba(255,255,255,.22);border-radius:20px;padding:3px 11px;font-weight:700;}
#mcv-root header p{opacity:.9;font-size:.9rem;}
#mcv-root .mcv-stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;align-items:center;}
#mcv-root .mcv-stat{background:rgba(255,255,255,.15);border-radius:10px;padding:8px 14px;font-size:.85rem;}
#mcv-root .mcv-stat b{font-size:1.05rem;display:block;}
#mcv-root .mcv-kakao-open{margin-left:auto;background:#fee500;color:#191919;font-weight:700;border-radius:10px;padding:10px 16px;font-size:.85rem;text-decoration:none;}
#mcv-root .mcv-card{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:16px;overflow:hidden;}
#mcv-root .mcv-card h2{font-size:1.05rem;padding:14px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
#mcv-root .mcv-seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;font-size:.75rem;font-weight:400;}
#mcv-root .mcv-seg button{padding:6px 12px;border:none;background:#fff;cursor:pointer;font-size:.75rem;color:#455a64;}
#mcv-root .mcv-seg button:not(:last-child){border-right:1px solid var(--line);}
#mcv-root .mcv-seg button.mcv-on{background:var(--blue);color:#fff;font-weight:700;}
#mcv-root .mcv-seg.mcv-course button.mcv-on{background:#2e7d32;}
#mcv-root .mcv-seg.mcv-kk button.mcv-on{background:#fee500;color:#191919;}
#mcv-root #mcv-mapWrap{position:relative;}
#mcv-root #mcv-map{height:520px;width:100%;background:#e8edf2;}
#mcv-root #mcv-mapErr{position:absolute;inset:0;background:rgba(244,246,248,.97);display:none;align-items:center;justify-content:center;padding:24px;text-align:center;z-index:1500;}
#mcv-root #mcv-mapErr .mcv-in{max-width:520px;font-size:.85rem;line-height:1.8;color:#455a64;}
#mcv-root #mcv-mapErr code{background:#e8edf2;border-radius:4px;padding:2px 6px;}
#mcv-root .mcv-legend{display:flex;gap:8px;flex-wrap:wrap;margin-left:auto;font-size:.75rem;font-weight:400;}
#mcv-root .mcv-chip{display:inline-flex;align-items:center;gap:5px;background:#f0f3f6;border-radius:20px;padding:3px 10px;}
#mcv-root .mcv-dot{width:10px;height:10px;border-radius:50%;display:inline-block;}
#mcv-root .mcv-locate-btn{position:absolute;z-index:1200;bottom:26px;right:18px;width:52px;height:52px;background:#fff;border:none;border-radius:50%;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.25);display:flex;align-items:center;justify-content:center;color:#546e7a;transition:.2s;}
.leaflet-container{font:inherit;background:#e8edf2;}
#mcv-root .mcv-lfIcon{background:none!important;border:none!important;}
#mcv-root .mcv-lfIcon>*{position:absolute;transform:translate(-50%,-50%);}
.leaflet-popup-content{margin:11px 13px;font-size:.83rem;line-height:1.6;}
.leaflet-popup-content-wrapper{border-radius:10px;}
#mcv-root .mcv-locate-btn:hover{transform:scale(1.08);}
#mcv-root .mcv-locate-btn svg{width:24px;height:24px;stroke:currentColor;}
#mcv-root .mcv-locate-btn.tracking{background:var(--blue);color:#fff;}
#mcv-root .mcv-my-dot{width:16px;height:16px;background:#1976d2;border:3px solid #fff;border-radius:50%;box-shadow:0 2px 6px rgba(0,0,0,.4);}
#mcv-root #mcv-chartBox{position:relative;padding:10px 14px 14px;}
#mcv-root #mcv-elev{width:100%;height:230px;display:block;cursor:crosshair;}
#mcv-root #mcv-tooltip{position:absolute;pointer-events:none;background:rgba(38,50,56,.94);color:#fff;padding:8px 11px;border-radius:8px;font-size:.78rem;line-height:1.5;display:none;white-space:nowrap;z-index:10;}
#mcv-root .mcv-tables{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px;padding:16px;}
#mcv-root .mcv-tables>div{min-width:0;overflow-x:auto;}
#mcv-root table{width:100%;border-collapse:collapse;font-size:.85rem;}
#mcv-root th{background:#f7f9fb;text-align:left;padding:9px 11px;border-bottom:2px solid var(--line);font-size:.77rem;color:#607d8b;white-space:nowrap;}
#mcv-root td{padding:9px 11px;border-bottom:1px solid #eef1f4;}
#mcv-root tr.mcv-row{cursor:pointer;}
#mcv-root tr.mcv-row:hover{background:#eef6ff;}
#mcv-root td.mcv-km{font-weight:700;white-space:nowrap;width:1%;font-variant-numeric:tabular-nums;}
#mcv-root td.mcv-qty{text-align:right;font-variant-numeric:tabular-nums;width:1%;}
#mcv-root tfoot td{font-weight:800;background:#f7f9fb;border-top:2px solid var(--line);}
#mcv-root .mcv-titleicon{width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:13px;color:#fff;}
#mcv-root .mcv-note{font-size:.75rem;color:#78909c;padding:10px 18px 14px;line-height:1.6;}
#mcv-root .mcv-kpoi{border-radius:50%;border:2px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;font-size:13px;color:#fff;width:28px;height:28px;cursor:pointer;}
#mcv-root .mcv-kkm{border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;line-height:1;box-shadow:0 1px 4px rgba(0,0,0,.35);cursor:pointer;}
/* km 표시 — 점은 코스 선 위 정확한 지점, 숫자는 화면상으로만 비켜서 겹침을 피한다 */
#mcv-root .mcv-kmMark{position:relative !important;width:0 !important;height:0 !important;overflow:visible !important;}
#mcv-root .mcv-kmDot{position:absolute !important;left:0 !important;top:0 !important;
  width:7px !important;height:7px !important;margin:0 !important;padding:0 !important;
  transform:translate(-50%,-50%) !important;border-radius:50% !important;background:#fff !important;
  border:2px solid var(--kc,#e53935) !important;box-shadow:0 0 0 1px rgba(0,0,0,.3) !important;}
#mcv-root .mcv-kmLine{position:absolute !important;margin:0 !important;padding:0 !important;
  background:var(--kc,#e53935) !important;opacity:.75 !important;pointer-events:none !important;}
#mcv-root .mcv-kmMark .mcv-kkm{position:absolute !important;left:0 !important;top:0 !important;margin:0 !important;
  transform:translate(-50%,-50%) translate(var(--kx,0px), var(--ky,-20px)) !important;}
#mcv-root .mcv-kstart{background:#2e7d32;color:#fff;border-radius:8px;padding:3px 8px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 1px 5px rgba(0,0,0,.4);border:2px solid #fff;}
#mcv-root .mcv-kturn{background:#f57c00;color:#fff;border-radius:8px;padding:3px 8px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 1px 5px rgba(0,0,0,.4);border:2px solid #fff;cursor:pointer;}
#mcv-root .mcv-kinfo{position:relative;background:#fff;border:1px solid #cfd8dc;border-radius:10px;padding:11px 28px 11px 13px;font-size:.83rem;line-height:1.6;box-shadow:0 4px 16px rgba(0,0,0,.28);white-space:nowrap;}
#mcv-root .mcv-kinfo:after{content:'';position:absolute;left:50%;bottom:-8px;margin-left:-8px;border:8px solid transparent;border-top-color:#fff;border-bottom:0;}
#mcv-root .mcv-kinfo .mcv-x{position:absolute;top:4px;right:7px;cursor:pointer;color:#90a4ae;font-size:14px;font-weight:700;}
#mcv-root .mcv-sumchips{display:flex;gap:9px;flex-wrap:wrap;padding:16px 16px 0;}
#mcv-root .mcv-sumchip{background:#eceff1;border-radius:10px;padding:9px 14px;font-size:.78rem;color:#455a64;}
#mcv-root .mcv-sumchip b{display:block;font-size:1.05rem;color:#263238;margin-top:2px;}
#mcv-root .mcv-printbtn{background:#37474f;color:#fff;border:none;border-radius:9px;padding:7px 13px;font-size:.75rem;font-weight:700;cursor:pointer;}
#mcv-root .mcv-ops{white-space:nowrap;font-variant-numeric:tabular-nums;color:#455a64;}
@media (max-width:900px){
  #mcv-root #mcv-map{height:62dvh;min-height:300px;}
  #mcv-root .mcv-wrap{padding:12px;}
  #mcv-root .mcv-tables{grid-template-columns:1fr;}
}
@media (max-width:640px){
  #mcv-root #mcv-elev{height:180px;}
  #mcv-root table{font-size:.8rem;}
  #mcv-root th, #mcv-root td{padding:8px;}
  #mcv-root .mcv-card h2{padding:12px;gap:8px;}
  #mcv-root .mcv-legend{margin-left:0;}
  /* 휴대전화 — 화면 폭에 맞춰 접는다 */
  #mcv-root .mcv-wrap{padding:9px;}
  #mcv-root header{padding:15px 16px;border-radius:12px;margin-bottom:10px;}
  #mcv-root header h1{font-size:1.18rem;gap:7px;}
  #mcv-root header p{font-size:.82rem;}
  #mcv-root #mcv-map{height:58dvh;min-height:270px;}
  #mcv-root .mcv-card{margin-bottom:10px;}
  #mcv-root .mcv-tables{padding:10px;gap:10px;}
  #mcv-root .mcv-tables>div{overflow-x:auto;-webkit-overflow-scrolling:touch;}
  #mcv-root .mcv-sumchips{padding:10px 10px 0;gap:6px;}
  #mcv-root .mcv-sumchip{padding:8px 11px;font-size:.74rem;}
  #mcv-root .mcv-seg button{padding:9px 12px;font-size:.75rem;}
  #mcv-root .mcv-printbtn{padding:9px 13px;}
  /* 인라인 크기·리셋보다 뒤에 오도록 강제 — 16px 미만이면 iOS가 화면을 확대한다 */
  #mcv-root input,#mcv-root select,#mcv-root textarea{font-size:16px !important;}
}
@media (pointer:coarse){
  #mcv-root .mcv-seg button{min-height:36px;}
  #mcv-root .mcv-printbtn{min-height:36px;}
}
@media print{
  #mcv-root .mcv-wrap{max-width:none;padding:0;}
  #mcv-root .mcv-card{break-inside:avoid;box-shadow:none;border-color:#bbb;margin-bottom:10px;}
  #mcv-root .mcv-seg,#mcv-root .mcv-locate-btn,#mcv-root #mcv-ovSeg,#mcv-root #mcv-typeSeg,
  #mcv-root #mcv-retSeg,#mcv-root #mcv-retRangeBox,#mcv-root #mcv-diagBtn{display:none !important;}
  #mcv-root header{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  #mcv-root .mcv-tables{grid-template-columns:1fr 1fr;}
  #mcv-root #mcv-map{height:380px !important;}
  #mcv-root th{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
}
#mcv-root{container-type:inline-size;box-sizing:border-box;text-align:left;font-size:16px;
  font-family:'Apple SD Gothic Neo','Malgun Gothic','Noto Sans KR',sans-serif;color:#263238;
  background:var(--mcv-bg,#f4f6f8);padding:0;margin:0;line-height:1.6;-webkit-text-size-adjust:100%;}
#mcv-root *,#mcv-root *:before,#mcv-root *:after{box-sizing:border-box;}
#mcv-root h1,#mcv-root h2,#mcv-root h3,#mcv-root h4,#mcv-root p,#mcv-root div,#mcv-root span,
#mcv-root table,#mcv-root thead,#mcv-root tbody,#mcv-root tfoot,#mcv-root tr,#mcv-root th,#mcv-root td,
#mcv-root label,#mcv-root canvas{margin:0;padding:0;border:0;background:none;float:none;
  font-family:inherit;letter-spacing:normal;text-transform:none;text-shadow:none;box-shadow:none;}
#mcv-root button,#mcv-root select,#mcv-root input{font-family:inherit;font-size:100%;margin:0;
  text-transform:none;letter-spacing:normal;box-shadow:none;text-shadow:none;min-height:0;line-height:1.4;}
#mcv-root a{text-decoration:none;}
#mcv-root table{border-collapse:collapse;border-spacing:0;width:100%;}
#mcv-root img,#mcv-root canvas,#mcv-root svg{max-width:100%;}
#mcv-root .mcv-wrap{max-width:var(--mcv-max,1240px);margin:0 auto;padding:16px;}
#mcv-root .mcv-tables{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));
  gap:14px;padding:16px;align-items:start;}
#mcv-root .mcv-tables>div{min-width:0;max-width:100%;overflow-x:auto;}
#mcv-root .mcv-tables table{min-width:max-content;}
#mcv-root #mcv-map{height:clamp(300px,46vh,540px);}
#mcv-root #mcv-elev{height:clamp(170px,24vh,240px);}
@container (max-width:560px){
  #mcv-root .mcv-wrap{padding:10px;}
  #mcv-root .mcv-tables{padding:10px;gap:10px;}
  #mcv-root .mcv-card>h2{padding:12px;gap:8px;}
  #mcv-root .mcv-stat{padding:7px 11px;font-size:.8rem;}
  #mcv-root table{font-size:.8rem;} #mcv-root th,#mcv-root td{padding:8px;}
}
@container (min-width:1100px){ #mcv-root .mcv-tables{gap:16px;} }
@container (min-width:1420px){ #mcv-root .mcv-tables{grid-template-columns:repeat(4,minmax(0,1fr));} }
/* ═══ 삽입한 홈페이지의 CSS가 덮어써도 레이아웃이 무너지지 않도록 고정 ═══ */
#mcv-root .mcv-seg{display:inline-flex !important;visibility:visible !important;opacity:1 !important;
  float:none !important;position:static !important;width:auto !important;height:auto !important;overflow:hidden !important;}
#mcv-root .mcv-seg button{display:inline-block !important;visibility:visible !important;opacity:1 !important;
  width:auto !important;height:auto !important;min-width:0 !important;min-height:0 !important;max-width:none !important;
  float:none !important;position:static !important;text-indent:0 !important;white-space:nowrap !important;
  border-radius:0 !important;line-height:1.4 !important;}
#mcv-root .mcv-card,#mcv-root .mcv-cat,#mcv-root .mcv-item{display:block !important;visibility:visible !important;opacity:1 !important;float:none !important;}
#mcv-root .mcv-card>h2{display:flex !important;flex-wrap:wrap !important;align-items:center !important;}
#mcv-root .mcv-cat-h,#mcv-root .mcv-chips,#mcv-root .mcv-stats,#mcv-root .mcv-cat-f{display:flex !important;flex-wrap:wrap !important;}
#mcv-root .mcv-tables{display:grid !important;}
#mcv-root #mcv-map{display:block !important;width:100% !important;min-height:280px !important;}
#mcv-root #mcv-mapWrap{position:relative !important;display:block !important;}
#mcv-root .mcv-c{display:inline-block !important;}
#mcv-root header,#mcv-root .mcv-wrap{display:block !important;visibility:visible !important;}
#mcv-root .mcv-pop{min-width:180px;max-width:280px;}
#mcv-root .mcv-pop-h{display:flex !important;align-items:center;gap:8px;margin-bottom:8px;}
#mcv-root .mcv-pop-t{display:flex;flex-direction:column;min-width:0;}
#mcv-root .mcv-pop-t b{font-size:.92rem;font-weight:700;color:#263238;line-height:1.35;}
#mcv-root .mcv-pop-t i{font-style:normal;font-size:.72rem;color:#78909c;}
#mcv-root .mcv-pop .mcv-chips{gap:5px;}
#mcv-root .mcv-pop .mcv-memo{margin-top:7px;padding-top:7px;border-top:1px solid #eef1f4;}

/* ═══ 지도 내부는 SDK 계산값을 그대로 둔다. 단, 우리가 만든 mcv- 요소는 예외에서 제외 ═══ */
#mcv-root #mcv-map *:not([class*="mcv-"]){box-sizing:content-box;max-width:none;max-height:none;}
#mcv-root #mcv-map div:not([class*="mcv-"]),#mcv-root #mcv-map span:not([class*="mcv-"]),
#mcv-root #mcv-map canvas,#mcv-root #mcv-map img,#mcv-root #mcv-map svg,
#mcv-root #mcv-map p:not([class*="mcv-"]),#mcv-root #mcv-map table,#mcv-root #mcv-map tr,
#mcv-root #mcv-map td,#mcv-root #mcv-map a:not([class*="mcv-"]){
  margin:revert;padding:revert;border:revert;background:revert;box-shadow:revert;
  float:none;position:revert;line-height:normal;font-size:revert;}
#mcv-root #mcv-map img{max-width:none !important;height:auto;}

/* ═══ 지도 위 우리 오버레이 — 지도 안이라도 카드 스타일을 유지 ═══ */
#mcv-root #mcv-map .mcv-kinfo{position:relative;background:rgba(255,255,255,.75);border:1px solid rgba(176,190,197,.75);
  border-radius:14px;padding:16px 38px 16px 18px;box-shadow:0 10px 30px rgba(38,50,56,.26);white-space:normal;
  font-size:.83rem;line-height:1.6;color:#263238;max-width:320px;
  -webkit-backdrop-filter:blur(10px) saturate(1.25);backdrop-filter:blur(10px) saturate(1.25);}
#mcv-root #mcv-map .mcv-kinfo:after{content:'';position:absolute;left:50%;bottom:-9px;margin-left:-9px;
  border:9px solid transparent;border-top-color:rgba(255,255,255,.75);border-bottom:0;}
#mcv-root #mcv-map .mcv-kinfo .mcv-x{position:absolute;top:9px;right:11px;cursor:pointer;color:#90a4ae;
  font-size:16px;font-weight:700;line-height:1;background:none;border:0;padding:2px 4px;border-radius:6px;}
#mcv-root #mcv-map .mcv-kinfo .mcv-x:hover{background:rgba(96,125,139,.12);color:#546e7a;}
#mcv-root #mcv-map .mcv-pop{min-width:186px;}
#mcv-root #mcv-map .mcv-pop-h{display:flex;align-items:center;gap:10px;margin-bottom:11px;}
#mcv-root #mcv-map .mcv-pop-t{display:flex;flex-direction:column;min-width:0;}
#mcv-root #mcv-map .mcv-pop-t b{font-size:.92rem;font-weight:700;color:#263238;line-height:1.35;}
#mcv-root #mcv-map .mcv-pop-t i{font-style:normal;font-size:.72rem;color:#78909c;}
#mcv-root #mcv-map .mcv-chips{display:flex;flex-wrap:wrap;gap:7px;}
#mcv-root #mcv-map .mcv-c{display:inline-block;font-size:.76rem;border-radius:7px;padding:5px 10px;
  white-space:nowrap;line-height:1.5;font-variant-numeric:tabular-nums;}
#mcv-root #mcv-map .mcv-c-go{background:#e6f1fb;color:#185fa5;font-weight:700;}
#mcv-root #mcv-map .mcv-c-back{background:#fdeee1;color:#9a5b1b;font-weight:700;}
#mcv-root #mcv-map .mcv-c-time{background:#fceaea;color:#a32d2d;font-weight:700;}
#mcv-root #mcv-map .mcv-c-sub{background:#f1f4f7;color:#546e7a;}
#mcv-root #mcv-map .mcv-c-sup{background:#eaf3de;color:#3b6d11;}
#mcv-root #mcv-map .mcv-memo{font-size:.78rem;color:#607d8b;margin-top:11px;padding-top:10px;
  border-top:1px solid rgba(207,216,220,.7);line-height:1.6;}
#mcv-root #mcv-map .mcv-titleicon{width:26px;height:26px;border-radius:8px;display:inline-flex;
  align-items:center;justify-content:center;font-size:13px;color:#fff;flex:none;}
#mcv-root #mcv-map .mcv-kpoi{width:28px;height:28px;border-radius:50%;border:2px solid #fff;
  box-shadow:0 1px 6px rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;
  font-size:13px;color:#fff;cursor:pointer;}
#mcv-root #mcv-map .mcv-kkm{border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-weight:800;line-height:1;box-shadow:0 1px 4px rgba(0,0,0,.35);cursor:pointer;}
#mcv-root #mcv-map .mcv-kmMark{position:relative !important;width:0 !important;height:0 !important;overflow:visible !important;}
#mcv-root #mcv-map .mcv-kmMark .mcv-kkm{position:absolute !important;left:0 !important;top:0 !important;margin:0 !important;
  transform:translate(-50%,-50%) translate(var(--kx,0px), var(--ky,-20px)) !important;}
#mcv-root #mcv-map .mcv-kstart{background:#2e7d32;color:#fff;border:2px solid #fff;border-radius:9px;
  padding:4px 10px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.4);}
#mcv-root #mcv-map .mcv-kturn{background:#f57c00;color:#fff;border:2px solid #fff;border-radius:9px;
  padding:4px 10px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.4);cursor:pointer;}

/* (반투명·블러 강제 규칙은 아래 '시설 정보 카드' 절에서 정리했다) */
