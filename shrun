  transition:background .18s var(--ease);}
#mcv-root .mcv-kinfo .mcv-x:hover{background:var(--divider);color:var(--dark);}
#mcv-root .mcv-kinfo .mcv-x:active{transform:scale(.92);}
#mcv-root .mcv-kinfo .mcv-pop-h{margin-bottom:14px;padding-right:34px;}
#mcv-root .mcv-kinfo .mcv-pop-t b{font-size:17px;line-height:1.3;letter-spacing:-.374px;color:var(--dark);}
#mcv-root .mcv-kinfo .mcv-pop-t i{font-size:13px;color:var(--sub);letter-spacing:0;}
#mcv-root .mcv-kinfo .mcv-titleicon{width:34px;height:34px;border-radius:var(--r-md);font-size:16px;}
#mcv-root .mcv-kinfo .mcv-c{font-size:13px;border-radius:var(--r-sm);padding:7px 11px;}
#mcv-root .mcv-kinfo .mcv-memo{font-size:13px;color:var(--sub);margin-top:14px;padding-top:12px;
  border-top:1px solid var(--line);}
@keyframes mcvFade{from{opacity:0}to{opacity:1}}
@keyframes mcvPop{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
