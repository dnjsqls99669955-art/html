function latlngAtKm(km){
  const d=km*1000; let lo=0,hi=cum.length-1;
  while(lo<hi){const m=(lo+hi)>>1; cum[m]<d?lo=m+1:hi=m;}
  const i=Math.max(1,lo),d0=cum[i-1],d1=cum[i],t=d1>d0?(d-d0)/(d1-d0):0;
  const a=C.track[i-1],b=C.track[i];
  return [a[0]+t*(b[0]-a[0]), a[1]+t*(b[1]-a[1])];
