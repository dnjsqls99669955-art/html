}
function cumOfPath(path){
  const c=[0], RADv=Math.PI/180;
  for(let i=1;i<path.length;i++){
    const dy=(path[i][0]-path[i-1][0])*111320;
    const dx=(path[i][1]-path[i-1][1])*111320*Math.cos(path[i][0]*RADv);
    c.push(c[i-1]+Math.sqrt(dx*dx+dy*dy));
