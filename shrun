function ptOnPath(pts, cm, d){
  const L=cm[cm.length-1];
  if(!(d>0)) return [pts[0][0],pts[0][1]];
  if(d>=L) return [pts[pts.length-1][0],pts[pts.length-1][1]];
  let lo=0,hi=cm.length-1;
  while(lo<hi){ const m=(lo+hi)>>1; cm[m]<d?lo=m+1:hi=m; }
  const i=Math.max(1,lo), t=(d-cm[i-1])/((cm[i]-cm[i-1])||1);
