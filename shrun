/* ── 복편(반환 후) 평행 오프셋 ── */
function offsetPath(path, meters){
  const n=path.length, out=[], RADv=Math.PI/180;
  for(let i=0;i<n;i++){
    const a=path[Math.max(0,i-1)], b=path[Math.min(n-1,i+1)];
    const lat=path[i][0], cosL=Math.cos(lat*RADv)||1;
    const ex=(b[1]-a[1])*cosL, ny=(b[0]-a[0]);
    const L=Math.sqrt(ex*ex+ny*ny);
    if(!L){ out.push([path[i][0],path[i][1]]); continue; }
    const pe=ny/L, pn=-ex/L;
    out.push([path[i][0]+meters*pn/111320, path[i][1]+meters*pe/(111320*cosL)]);
  }
