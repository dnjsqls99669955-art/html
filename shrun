/* 말풍선도 같은 이유로 밝은 면 고정 */
/* 버튼 — pearl capsule / 잉크 유틸 */
#mcv-root .mcv-printbtn,#mcv-root .mcv-locate-btn,#mcv-root #mcv-diagBtn{
