    ctx.beginPath();ctx.moveTo(hoverX,PAD.t);ctx.lineTo(hoverX,H-PAD.b);
    ctx.strokeStyle='rgba(38,50,56,.55)';ctx.lineWidth=1;ctx.setLineDash([4,3]);ctx.stroke();ctx.setLineDash([]);
    ctx.beginPath();ctx.arc(hoverX,y(ele),5,0,7);ctx.fillStyle='#e53935';ctx.fill();
    ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();
    return {km,ele};
  }
  return null;
}
canvas.addEventListener('mousemove',ev=>{
  const r=canvas.getBoundingClientRect(), res=drawChart(ev.clientX-r.left);
  if(!res){tooltip.style.display='none';return;}
  let near='';
  C.pois.forEach(p=>passInfo(p).forEach(x2=>{
    if(Math.abs(x2.km-res.km)<=Math.max(0.15,C.total_km*0.006))
      near+='<br>'+CAT[p.cat].icon+' '+esc(p.name)+(x2.d?' '+dirLabel(x2.d):'')+' ('+x2.km.toFixed(2)+'km)'+(p.time?' · '+esc(p.time):'');
  }));
  const P=C.profile;
  let i=0; while(i<P.length-1&&P[i+1][0]<res.km) i++;
  const j=Math.min(i+4,P.length-1);
  const grade=P[j][0]>P[i][0]?((P[j][1]-P[i][1])/((P[j][0]-P[i][0])*1000)*100):0;
  const tk=turnOf(C);
  tooltip.innerHTML='<b>'+res.km.toFixed(2)+' km</b>'+(tk!=null?' <span style="color:#ffb74d">'+(res.km>tk?'복편':'왕편')+'</span>':'')+
    '<br>고도 '+res.ele.toFixed(0)+' m · 경사 '+grade.toFixed(1)+'%'+near;
  tooltip.style.display='block';
  const box=document.getElementById('mcv-chartBox').getBoundingClientRect();
  let tx=ev.clientX-box.left+14;
  if(tx+tooltip.offsetWidth>box.width-10) tx=ev.clientX-box.left-tooltip.offsetWidth-14;
  tooltip.style.left=tx+'px'; tooltip.style.top=(ev.clientY-box.top-10)+'px';
  if(kReady&&kmap){
    const ll=displayAtKm(res.km);
    if(!kHover) kHover=kOv(ll,'<div style="width:16px;height:16px;background:#e53935;border:3px solid #fff;border-radius:50%;box-shadow:0 2px 6px rgba(0,0,0,.4)"></div>',800);
    else kHover.setPosition(ll);
  }
});
canvas.addEventListener('mouseleave',()=>{
  drawChart(null); tooltip.style.display='none';
  if(kHover){kHover.rm();kHover=null;}
});
