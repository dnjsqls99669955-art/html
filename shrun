    const items=C.pois.filter(p=>p.cat===cat.id);
    if(!items.length) return;
    const supIds=ADMIN?SUP.filter(s=>items.some(p=>(p.sup||{})[s.id])).map(s=>s.id):[];
    let h='<div class="mcv-cat"><div class="mcv-cat-h">'+
      '<span class="mcv-titleicon" style="background:'+cat.color+'">'+cat.icon+'</span>'+
      '<b>'+esc(cat.label)+'</b><span class="mcv-n">'+items.length+'</span></div>';
    items.forEach(p=>{
      const info=passInfo(p), idx=C.pois.indexOf(p);
      const go=info.find(x=>x.d!=='back'), back=info.find(x=>x.d==='back');
      let c='';
      if(cat.hasTime){
        c+='<span class="mcv-c mcv-c-go">'+info[0].km.toFixed(2)+' km</span>';
        if(p.time) c+='<span class="mcv-c mcv-c-time">⏱ '+esc(p.time)+'</span>';
      } else if(go && back){
        c+='<span class="mcv-c mcv-c-go">'+esc(T.colGo)+' '+go.km.toFixed(2)+' km</span>'+
           '<span class="mcv-c mcv-c-back">'+esc(T.colBack)+' '+back.km.toFixed(2)+' km</span>';
      } else if(back){
        c+='<span class="mcv-c mcv-c-back">'+esc(T.colBack)+' '+back.km.toFixed(2)+' km</span>';
      } else if(go){
        c+='<span class="mcv-c mcv-c-go">'+(info.length>1?esc(T.colGo)+' ':'')+go.km.toFixed(2)+' km</span>';
      }
      if(COLS.gap && p.gap!=null && p.gap>0) c+='<span class="mcv-c mcv-c-sub">'+esc(T.colGap||'간격')+' +'+p.gap.toFixed(2)+'</span>';
      if(COLS.ele && C.hasEle && p.ele!=null) c+='<span class="mcv-c mcv-c-sub">고도 '+p.ele+' m</span>';
      if(COLS.ops && p.ops) c+='<span class="mcv-c mcv-c-sub">'+esc(T.colOps||'운영 시간')+' '+esc(p.ops)+'</span>';
      if(ADMIN && p.people) c+='<span class="mcv-c mcv-c-sub">👥 '+p.people.toLocaleString()+'명</span>';
      supIds.forEach(sid=>{
        const o=SUP.find(v=>v.id===sid), u=(p.sup||{})[sid]||0;
        if(!u) return;
        const b=boxesOf(o,u);
        c+='<span class="mcv-c mcv-c-sup">'+esc(o.label)+' '+u.toLocaleString()+esc(o.unit)+(b!=null?' · '+b+'박스':'')+'</span>';
      });
      h+='<div class="mcv-item" data-i="'+idx+'"><div class="mcv-nm">'+esc(p.name)+'</div>'+
         '<div class="mcv-chips">'+c+'</div>'+
         (COLS.memo&&p.memo?'<div class="mcv-memo">'+esc(p.memo)+'</div>':'')+'</div>';
    });
    if(supIds.length){
      h+='<div class="mcv-cat-f">'+supIds.map(sid=>{
        const o=SUP.find(v=>v.id===sid);
        const u=items.reduce((a,p)=>a+((p.sup||{})[sid]||0),0), b=boxSum(o,items);
        return '<span><b>'+esc(o.label)+'</b> '+u.toLocaleString()+esc(o.unit)+(b!=null?' ('+b+'박스)':'')+'</span>';
      }).join('')+'</div>';
    }
    h+='</div>';
    const wrap=document.createElement('div'); wrap.innerHTML=h;
    wrap.querySelectorAll('.mcv-item').forEach(el=>{
      el.addEventListener('click',()=>{
        const p=C.pois[+el.dataset.i];
        if(kReady){ mapFocus(p.lat,p.lon); showInfo(poiInfoHtml(p),p.lat,p.lon); }
        else pendingFocus={lat:p.lat, lon:p.lon, html:poiInfoHtml(p)};
        scrollToMap();
      });
    });
    box.appendChild(wrap);
  });
  if(!box.children.length) box.innerHTML='<div style="padding:24px;color:#90a4ae;font-size:.85rem">이 코스에는 등록된 시설이 없습니다.</div>';
}
function renderSupplies(){
  if(!ADMIN) return;
  const totals={};
  C.pois.forEach(p=>Object.entries(p.sup||{}).forEach(([k,v])=>{totals[k]=(totals[k]||0)+v;}));
  const keys=SUP.filter(s=>totals[s.id]);
  document.getElementById('mcv-supChips').innerHTML=keys.length
    ? keys.map(s=>{const b=boxSum(s,C.pois);
        return '<div class="mcv-sumchip">'+esc(s.label)+'<b>'+totals[s.id].toLocaleString()+' '+esc(s.unit)+
          (b!=null?'<br><span style="font-size:.72rem;color:#546e7a">'+b+'박스'+(s.boxNote?' ('+esc(s.boxNote)+')':'')+'</span>':'')+'</b></div>';}).join('')
    : '<div style="color:#90a4ae;font-size:.85rem;padding-bottom:10px">입력된 물자가 없습니다.</div>';
  const box=document.getElementById('mcv-supTable'); box.innerHTML='';
  if(!keys.length) return;
  let h='<div><table><thead><tr><th>지점</th><th>'+esc(T.colName)+'</th><th style="text-align:right">통과 인원</th><th>'+esc(T.colOps||'운영 시간')+'</th>'+
    keys.map(s=>'<th style="text-align:right">'+esc(s.label)+'<br><span style="font-weight:400">'+esc(s.unit)+(s.boxNote?' · '+esc(s.boxNote):'')+'</span></th>').join('')+'</tr></thead><tbody>';
  C.pois.forEach(p=>{
    if(!p.sup||!Object.keys(p.sup).length) return;
    h+='<tr><td class="mcv-km">'+passInfo(p)[0].km.toFixed(2)+' km</td><td>'+CAT[p.cat].icon+' '+esc(p.name)+'</td>'+
      '<td class="mcv-qty">'+(p.people?p.people.toLocaleString():'—')+'</td>'+
      '<td class="mcv-ops">'+esc(p.ops||'—')+'</td>'+
      keys.map(s=>{const u=p.sup[s.id]||0, b=boxesOf(s,u);
        return '<td class="mcv-qty">'+(u?u.toLocaleString()+(b!=null?'<div style="font-size:.68rem;color:#90a4ae">'+b+'박스</div>':''):'')+'</td>';}).join('')+'</tr>';
  });
  h+='</tbody><tfoot><tr><td colspan="4">합계'+(C.participants?' · 참가 '+C.participants.toLocaleString()+'명':'')+'</td>'+
    keys.map(s=>{const b=boxSum(s,C.pois);
      return '<td class="mcv-qty">'+totals[s.id].toLocaleString()+(b!=null?'<div style="font-size:.68rem;color:#546e7a">'+b+'박스</div>':'')+'</td>';}).join('')+'</tr></tfoot></table></div>';
  box.innerHTML=h;
}
/* 구간별 통과 예상 시각 (관리자용) */
function hm(str){ const m=String(str||'').match(/^(\d{1,2}):([0-5]\d)$/); return m?(+m[1])*60+(+m[2]):null; }
function paceMin(str){ const m=String(str||'').match(/^(\d+):([0-5]?\d)$/); return m?(+m[1])+(+m[2])/60:null; }
function toHm(mins){ let t=Math.round(mins); t=((t%1440)+1440)%1440; return String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0'); }
function paceStr(p){ const s=Math.round(p*60); return Math.floor(s/60)+':'+String(s%60).padStart(2,'0'); }
function renderPace(){
  if(!ADMIN) return;
  const ev=DATA.event||{start:'08:00',lead:'3:30',last:'9:00'};
  const st=hm(ev.start)||0, lead=paceMin(ev.lead)||3.5, lim=C.limitPace||null;
  const bands=[{label:'선두 '+ev.lead, pace:lead}];
  if(lim&&lim>lead){
    for(let i=1;i<=3;i++){ const p=lead+(lim-lead)*i/4; bands.push({label:paceStr(p), pace:p}); }
    bands.push({label:'제한 '+paceStr(lim), pace:lim, limit:true});
  } else { [4.5,5.5,6.5,paceMin(ev.last)||9].forEach(p=>{ if(p>lead) bands.push({label:paceStr(p), pace:p}); }); }
  document.getElementById('mcv-paceLabel').textContent='— '+C.name+' · 출발 '+ev.start+(C.limit?' · 제한 '+C.limit:'');
  const step=+document.getElementById('mcv-paceStep').value, onlyPoi=document.getElementById('mcv-paceOnlyPoi').checked;
  const tk=turnOf(C);
  const marks=[];
  if(onlyPoi){
    C.pois.forEach(p=>passInfo(p).forEach(r=>marks.push({km:r.km, label:CAT[p.cat].icon+' '+p.name+(r.d?' '+dirLabel(r.d):'')})));
    marks.sort((a,b)=>a.km-b.km);
  } else {
    for(let k=step;k<C.total_km;k+=step) marks.push({km:k,label:''});
    if(tk!=null) marks.push({km:tk,label:'↩ 반환'});
    marks.push({km:C.total_km,label:'피니시'});
    marks.sort((a,b)=>a.km-b.km);
  }
  let h='<div><table><thead><tr><th>거리</th><th>지점</th>'+
    bands.map(b=>'<th style="text-align:right'+(b.limit?';color:#c62828':'')+'">'+esc(b.label)+'</th>').join('')+'</tr></thead><tbody>';
  marks.forEach(m=>{
    const isTurn=(tk!=null&&Math.abs(m.km-tk)<1e-6);
    h+='<tr'+(isTurn?' style="background:#fff8e1"':'')+'><td class="mcv-km">'+m.km.toFixed(2)+' km</td><td style="color:#607d8b;white-space:nowrap">'+esc(m.label)+'</td>'+
      bands.map(b=>'<td class="mcv-qty"'+(b.limit?' style="color:#c62828;font-weight:700"':'')+'>'+toHm(st+m.km*b.pace)+'</td>').join('')+'</tr>';
  });
  h+='</tbody></table></div>';
  document.getElementById('mcv-paceTable').innerHTML=h;
}
if(ADMIN){
  document.getElementById('mcv-paceStep').onchange=renderPace;
  document.getElementById('mcv-paceOnlyPoi').onchange=renderPace;
}
const hiddenCats=new Set();
function renderLegend(){
  const used=[...new Set(C.pois.map(p=>p.cat))];
  const box=document.getElementById('mcv-legend'); if(!box) return;
  box.innerHTML=used.map(id=>{
    const c=CAT[id], off=hiddenCats.has(id);
    return '<button type="button" class="mcv-chip'+(off?' mcv-chip-off':'')+'" data-cat="'+id+'" '+
      'title="지도에서 '+esc(c.label)+' 켜기/끄기" aria-pressed="'+(!off)+'">'+
      '<span class="mcv-dot" style="background:'+c.color+'"></span>'+esc(c.label)+'</button>';
  }).join('');
  box.querySelectorAll('[data-cat]').forEach(b=>{
    b.onclick=()=>{
      const id=b.dataset.cat;
      if(hiddenCats.has(id)) hiddenCats.delete(id); else hiddenCats.add(id);
      renderLegend(); rebuildMap(false);
    };
  });
}
