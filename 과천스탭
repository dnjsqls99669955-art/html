function latlngAtKm(km){
  const d=km*1000; let lo=0,hi=cum.length-1;
  while(lo<hi){const m=(lo+hi)>>1; cum[m]<d?lo=m+1:hi=m;}
  const i=Math.max(1,lo),d0=cum[i-1],d1=cum[i],t=d1>d0?(d-d0)/(d1-d0):0;
  const a=C.track[i-1],b=C.track[i];
  return [a[0]+t*(b[0]-a[0]), a[1]+t*(b[1]-a[1])];
}
/* ── 복편(반환 후) 평행 오프셋 ── */
function offsetPath(path, meters){
  const n=path.length, out=[], RADv=Math.PI/180;
  for(let i=0;i<n;i++){
    const a=path[Math.max(0,i-1)], b=path[Math.min(n-1,i+1)];
    const lat=path[i][0], cosL=Math.cos(lat*RADv)||1;
    const ex=(b[1]-a[1])*cosL, ny=(b[0]-a[0]);
    const L=Math.sqrt(ex*ex+ny*ny);
    if(!L){ out.push([path[i][0],path[i][1]]); continue; }
    const pe=ny/L, pn=-ex/L;
    out.push([path[i][0]+meters*pn/111320, path[i][1]+meters*pe/(111320*cosL)]);
  }
  return out;
}
function splitPath(km){
  if(cum.length!==C.track.length) computeCum();      /* 누적거리가 어긋나면 다시 계산 */
  const d=km*1000, go=[], back=[];
  let cut=false;
  for(let i=0;i<C.track.length;i++){
    if(!cut && cum[i]<=d){ go.push([C.track[i][0],C.track[i][1]]); continue; }
    if(!cut){ const t=latlngAtKm(km); go.push(t); back.push(t); cut=true; }
    back.push([C.track[i][0],C.track[i][1]]);
  }
  if(!back.length) back.push(latlngAtKm(km));
  return {go, back};
}
function cumOfPath(path){
  const c=[0], RADv=Math.PI/180;
  for(let i=1;i<path.length;i++){
    const dy=(path[i][0]-path[i-1][0])*111320;
    const dx=(path[i][1]-path[i-1][1])*111320*Math.cos(path[i][0]*RADv);
    c.push(c[i-1]+Math.sqrt(dx*dx+dy*dy));
