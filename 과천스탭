  }
  const pl=new kakao.maps.Polyline({path:pts.map(a=>new kakao.maps.LatLng(a[0],a[1])),
    strokeColor:o.color, strokeWeight:o.weight, strokeOpacity:o.opacity,
    strokeStyle:o.dash?'shortdash':'solid'});
  pl.setMap(kmap); kObjs.push({rm:()=>pl.setMap(null)});
