function ptOnPath(pts, cm, d){
  const L=cm[cm.length-1];
  if(!(d>0)) return [pts[0][0],pts[0][1]];
  if(d>=L) return [pts[pts.length-1][0],pts[pts.length-1][1]];
  let lo=0,hi=cm.length-1;
  while(lo<hi){ const m=(lo+hi)>>1; cm[m]<d?lo=m+1:hi=m; }
  const i=Math.max(1,lo), t=(d-cm[i-1])/((cm[i]-cm[i-1])||1);
  return [pts[i-1][0]+t*(pts[i][0]-pts[i-1][0]), pts[i-1][1]+t*(pts[i][1]-pts[i-1][1])];
}
let retDisp=null;                                   /* 화면에 그려진 복편 점선 */
function displayAtKm(km){
  const ll=latlngAtKm(km), t=turnOf(C);
  if(!RETON || t==null || km<=t) return ll;
  if(retDisp && retDisp.pts.length>1){
    const span=C.total_km-retDisp.turn;
    if(span>0){
      const f=Math.max(0,Math.min(1,(km-retDisp.turn)/span));
      return ptOnPath(retDisp.pts, retDisp.cum, f*retDisp.cum[retDisp.cum.length-1]);
    }
  }
  const eps=Math.max(0.005, Math.min(0.03, C.total_km/300));
  const a=latlngAtKm(Math.max(t, km-eps)), b=latlngAtKm(Math.min(C.total_km, km+eps));
  return offsetPath([a, ll, b], RETOFF)[1];
}
const kmSize=k=>k%5===0?22:15;
