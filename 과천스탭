/* 가까이에 시설이 있으면 숫자를 반대쪽으로 비켜 놓는다 (점은 그대로) */
function kmDir(ll){
  const cosL=Math.cos(ll[0]*Math.PI/180)||1;
  let bx=0,by=0,hit=false;
  C.pois.forEach(p=>{
    if(hiddenCats.has(p.cat)) return;
    const dy=(p.lat-ll[0])*111320, dx=(p.lon-ll[1])*111320*cosL;
    const d=Math.sqrt(dx*dx+dy*dy);
    if(d<70){ hit=true; bx+=dx/(d||1); by+=dy/(d||1); }
  });
  if(!hit) return 0;
  if(Math.abs(by)>=Math.abs(bx)) return by>0?1:0;
  return bx>0?3:2;
}
