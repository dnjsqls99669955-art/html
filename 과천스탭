const canvas=document.getElementById('mcv-elev'), ctx=canvas.getContext('2d'), tooltip=document.getElementById('mcv-tooltip');
const PAD={l:46,r:14,t:14,b:26};
function eleAtKm(km){
  const P=C.profile;
  let i=0; while(i<P.length-1&&P[i+1][0]<km) i++;
  const [k0,e0]=P[i],[k1,e1]=P[Math.min(i+1,P.length-1)];
  const t=k1>k0?(km-k0)/(k1-k0):0;
  return e0+t*(e1-e0);
}
function drawChart(hoverX){
  const P=C.profile,total=C.total_km;
  const dpr=window.devicePixelRatio||1,W=canvas.clientWidth,H=canvas.clientHeight;
  canvas.width=W*dpr; canvas.height=H*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,W,H);
  if(!C.hasEle){ ctx.fillStyle='#90a4ae'; ctx.font='13px sans-serif'; ctx.textAlign='center'; ctx.fillText('고도 정보가 없는 코스입니다',W/2,H/2); return null; }
  let eMin=Math.floor(C.ele_min/10)*10, eMax=Math.ceil(C.ele_max/10)*10+10;
  if(eMax-eMin<30) eMax=eMin+30;
  const iw=W-PAD.l-PAD.r, ih=H-PAD.t-PAD.b;
  const x=km=>PAD.l+iw*km/total, y=e=>PAD.t+ih*(1-(e-eMin)/(eMax-eMin));
  const eStep=(eMax-eMin)>120?50:((eMax-eMin)>60?25:10);
  ctx.font='10px sans-serif'; ctx.fillStyle='#90a4ae'; ctx.strokeStyle='#eceff1'; ctx.lineWidth=1;
  for(let e=eMin;e<=eMax;e+=eStep){
    ctx.beginPath();ctx.moveTo(PAD.l,y(e));ctx.lineTo(W-PAD.r,y(e));ctx.stroke();
    ctx.textAlign='right';ctx.fillText(e+'m',PAD.l-6,y(e)+3);
  }
  const kStep=total>25?5:(total>8?2:1);
  for(let k=0;k<=total;k+=kStep){
    ctx.beginPath();ctx.moveTo(x(k),PAD.t);ctx.lineTo(x(k),H-PAD.b);ctx.stroke();
    ctx.textAlign='center';ctx.fillText(k+'km',x(k),H-8);
  }
  const tk=turnOf(C);
  if(tk!=null){
    ctx.beginPath();ctx.moveTo(x(tk),PAD.t);ctx.lineTo(x(tk),H-PAD.b);
    ctx.strokeStyle='#f57c00';ctx.lineWidth=1.5;ctx.setLineDash([5,4]);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle='#ef6c00';ctx.textAlign='center';ctx.font='bold 10px sans-serif';
    ctx.fillText('↩ 반환',x(tk),PAD.t+10); ctx.font='10px sans-serif';
  }
  const grad=ctx.createLinearGradient(0,PAD.t,0,H-PAD.b);
  grad.addColorStop(0,'rgba(25,118,210,.45)');grad.addColorStop(1,'rgba(25,118,210,.05)');
  ctx.beginPath(); ctx.moveTo(x(P[0][0]),y(P[0][1]));
  for(const [k,e] of P) ctx.lineTo(x(k),y(e));
  ctx.lineTo(x(P[P.length-1][0]),H-PAD.b); ctx.lineTo(x(P[0][0]),H-PAD.b); ctx.closePath();
  ctx.fillStyle=grad; ctx.fill();
  ctx.beginPath(); ctx.moveTo(x(P[0][0]),y(P[0][1]));
  for(const [k,e] of P) ctx.lineTo(x(k),y(e));
  ctx.strokeStyle='#1565c0'; ctx.lineWidth=2; ctx.stroke();
  C.pois.forEach(p=>passInfo(p).forEach(r=>{
    ctx.beginPath(); ctx.arc(x(r.km),y(eleAtKm(r.km)),4,0,7);
    ctx.fillStyle=CAT[p.cat].color; ctx.fill();
    ctx.strokeStyle='#fff'; ctx.lineWidth=1.5; ctx.stroke();
  }));
  if(hoverX!=null&&hoverX>=PAD.l&&hoverX<=W-PAD.r){
    const km=(hoverX-PAD.l)/iw*total, ele=eleAtKm(km);
    ctx.beginPath();ctx.moveTo(hoverX,PAD.t);ctx.lineTo(hoverX,H-PAD.b);
    ctx.strokeStyle='rgba(38,50,56,.55)';ctx.lineWidth=1;ctx.setLineDash([4,3]);ctx.stroke();ctx.setLineDash([]);
    ctx.beginPath();ctx.arc(hoverX,y(ele),5,0,7);ctx.fillStyle='#e53935';ctx.fill();
    ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();
    return {km,ele};
  }
  return null;
}
