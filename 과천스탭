  if(OSM){
    const pl=L.polyline(pts,{color:o.color, weight:o.weight, opacity:o.opacity,
      dashArray:o.dash?'9 8':null, interactive:!!o.onClick}).addTo(kmap);
    if(o.onClick) pl.on('click', ev=>{ L.DomEvent.stopPropagation(ev); o.onClick(ev.latlng.lat, ev.latlng.lng); });
    kObjs.push({rm:()=>kmap.removeLayer(pl)});
