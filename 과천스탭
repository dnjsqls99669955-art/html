function clearObjs(){ kObjs.forEach(o=>{ try{o.rm();}catch(e){} }); kObjs=[]; }
function cleanPath(path){                        /* NaN·빈값이 하나라도 섞이면 선이 통째로 안 그려진다 */
  const out=[];
  for(let i=0;i<(path||[]).length;i++){
    const p=path[i]; if(!p) continue;
    const a=p[0], b=p[1];
    if(a===null||a===undefined||a===''||b===null||b===undefined||b==='') continue;
    const la=+a, lo=+b;
    if(!isFinite(la)||!isFinite(lo)) continue;
    if(la<-90||la>90||lo<-180||lo>180) continue;
    if(Math.abs(la)<0.5&&Math.abs(lo)<0.5) continue;      /* (0,0) 널아일랜드 제외 */
    out.push([la,lo]);
  }
  return out;
}
function mkPoly(path, o){
